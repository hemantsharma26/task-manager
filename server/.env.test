# Settings for the automated tests (NODE_ENV=test). Safe to commit: nothing here is a real secret.
# MONGODB_URI is not set here on purpose: the test run starts a throwaway MongoDB and injects its address.
NODE_ENV=test
JWT_SECRET=test-secret-test-secret-test-secret-123
LOG_LEVEL=silent
CACHE_ENABLED=true
CACHE_TTL_TASK_LIST_SECONDS=60
CACHE_TTL_TASK_STATS_SECONDS=60
CACHE_TTL_COLUMNS_SECONDS=300
