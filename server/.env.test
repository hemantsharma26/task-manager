# Settings for the automated tests (NODE_ENV=test). Safe to commit: nothing here is a real secret.
# MONGODB_URI is not set here on purpose: the test run starts a throwaway MongoDB and injects its address.
NODE_ENV=test
JWT_SECRET=test-secret-test-secret-test-secret-123
PASSWORD_PEPPER=test-pepper-test-pepper-test-pepper-456
LOG_LEVEL=silent
# Tests must never touch a real Redis: empty here wins over anything in .env. (Tests that need Redis start their own.)
REDIS_URL=
CACHE_ENABLED=true
CACHE_TTL_TASK_LIST_SECONDS=60
CACHE_TTL_TASK_STATS_SECONDS=60
CACHE_TTL_COLUMNS_SECONDS=300
# The tests sign in hundreds of times from one address; the rate-limit tests switch this back on.
RATE_LIMITING_ENABLED=false
REGISTER_MAX_PER_IP=100000
