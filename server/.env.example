# Copy to .env and adjust:   cp .env.example .env
# Every setting the server reads is listed here. Anything left out uses the default shown.
# Real environment variables (Docker, a server, CI) always win over this file.

# ----- app --------------------------------------------------------------------------------------
NODE_ENV=development
PORT=4100
# debug | info | warn | error | silent   (default: debug in development, info in production, silent in tests)
# LOG_LEVEL=info
# How many reverse proxies (nginx, a load balancer) sit in front of the app. Needed for the real client IP.
# TRUST_PROXY_HOPS=1

# ----- database ---------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/task-manager

# ----- auth -------------------------------------------------------------------------------------
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# A second, different secret that is mixed into every password before hashing (a "pepper").
# Generate one the same way. If you change it, existing passwords stop working, so treat it like JWT_SECRET.
PASSWORD_PEPPER=change-me-pepper-a-different-long-random-string-32chars
# Sign-in gives a short-lived access token plus a rotating refresh token.
# ACCESS_TOKEN_MINUTES=15
# A session ends after this many days without use, or SESSION_MAX_DAYS after sign-in, whichever comes first.
# REFRESH_TOKEN_DAYS=7
# SESSION_MAX_DAYS=30
# Failed sign-ins before that account+IP pair is locked, and for how long.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# Soft cap on failed sign-ins for one email from anywhere (catches guessing spread over many IPs).
# LOGIN_EMAIL_MAX_ATTEMPTS=25
# LOGIN_EMAIL_WINDOW_MINUTES=60
# New accounts allowed per IP per window.
# REGISTER_MAX_PER_IP=10
# REGISTER_WINDOW_MINUTES=60
# Origin of the React dev server (only used for CORS in development).
CLIENT_ORIGIN=http://localhost:5173
# Extra origins (comma separated) that may send write requests in production. Your own origin is always allowed.
# ALLOWED_ORIGINS=https://app.example.com
# Send Strict-Transport-Security from this app. Normally nginx does this, so leave it off unless the app itself serves HTTPS.
# HSTS_ENABLED=false
# On by default in production. Set to false only when serving over plain http (no TLS),
# otherwise the browser drops the session cookie.
# COOKIE_SECURE=true

# ----- cache ------------------------------------------------------------------------------------
# Shared cache. Leave it out to use a small in-process cache instead (fine for one instance).
#   REDIS_URL=redis://127.0.0.1:6379
#   REDIS_URL=rediss://:password@host:6380        (rediss:// = TLS)
REDIS_URL=redis://127.0.0.1:6379
# false = skip caching completely and read from MongoDB every time.
CACHE_ENABLED=true
# How long a cached result may be served, in seconds. Writes also invalidate it immediately.
CACHE_TTL_TASK_LIST_SECONDS=60
CACHE_TTL_TASK_STATS_SECONDS=60
CACHE_TTL_COLUMNS_SECONDS=300
# CACHE_TTL_PRIORITIES_SECONDS=300

# ----- email (invitations, assignment notices) --------------------------------------------------
# Leave SMTP_URL out in development: emails are then only printed in the log, never sent.
#   SMTP_URL=smtp://user:password@smtp.example.com:587
#   SMTP_URL=smtps://user:password@smtp.gmail.com:465      (Gmail needs an app password)
# SMTP_URL=
# Shown as the sender. Use an address your SMTP account is allowed to send from.
# MAIL_FROM=Task Manager <no-reply@example.com>
# Where links in emails point (the address people open the app on).
# APP_URL=http://localhost:5173

# ----- uploads ----------------------------------------------------------------------------------------
# Where attached images, videos and PDFs are stored (relative to the server folder). Back this folder up.
# UPLOAD_DIR=uploads

# ----- rate limiting (per client IP) ------------------------------------------------------------
RATE_LIMIT_API_MAX=600
RATE_LIMIT_API_WINDOW_SECONDS=60
# Writes (create/edit/move/delete) per signed-in user.
# RATE_LIMIT_WRITE_MAX=240
# RATE_LIMIT_WRITE_WINDOW_SECONDS=60
# RATE_LIMITING_ENABLED=true
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
