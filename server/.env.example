# Copy to .env and adjust.
NODE_ENV=development
PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017/task-manager
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=7d
# Origin of the React dev server (only used for CORS in development).
CLIENT_ORIGIN=http://localhost:5173
# Set to false only when serving over plain http (no TLS), otherwise the browser drops the session cookie.
# COOKIE_SECURE=true
